# Copy to .env.local for local development. In production (Vercel), set the
# same variables in the project settings. See README.md → Setup.
# Variables prefixed NEXT_PUBLIC_ are visible to browsers — never put secrets in them.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public origin, no trailing slash. Use http://localhost:3000 locally.
# Until this is an https:// URL, robots.txt blocks all crawlers (pre-launch safety).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Time zone used for displayed dates (IANA name).
NEXT_PUBLIC_SITE_TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local: `npm run db:local` runs a zero-install Postgres (PGlite) on this URL.
# Production: Supabase → Project Settings → Database → Connection pooling
#   (session pooler, port 5432), e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The app connects exactly as written here. The session pooler caps clients at the pool
# size (15) and serverless instances can fill it; before switching to the transaction
# pooler (port 6543) run `npm run db:check` and read docs/DEPLOYMENT.md. The deploy's
# migration step uses DATABASE_MIGRATION_URL when set, otherwise DATABASE_URL, and
# retries while the pooler is full.
# Keep Vercel's function region (vercel.json "regions") in the same region as
# this database — see docs/DEPLOYMENT.md → Function region.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Local PGlite server serves one connection at a time (others queue), so use a
# pool of 1 with a 1s idle timeout to hand the turn over quickly.
# Supabase/production: DATABASE_POOL_MAX=2, DATABASE_IDLE_TIMEOUT=20.
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT=1
# Local builds only: one static-generation worker so `next build` doesn't
# open parallel connections to the local PGlite server. Leave unset on Vercel.
BUILD_WORKERS=1

# ---------------------------------------------------------------------------
# Authentication (GitHub OAuth, single owner)
# ---------------------------------------------------------------------------
# 32+ random bytes; used for HMAC (contact tokens, IP hashing).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:  http://localhost:3000        (production: your domain)
#   Callback URL:  http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The ONLY account allowed in. Prefer the numeric id (immutable):
#   curl https://api.github.com/users/<your-username>  → "id"
ADMIN_GITHUB_ID=
# Fallback if ADMIN_GITHUB_ID is empty (usernames can be renamed/re-registered).
ADMIN_GITHUB_LOGIN=
# Local-only sign-in button without GitHub. Ignored unless NODE_ENV=development.
AUTH_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Media (Cloudflare R2). Leave empty locally to store files in .data/media.
# ---------------------------------------------------------------------------
# MEDIA_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_URL=
# Imports (Studio → Import) refuse to upload media to R2 from a non-production
# environment unless you opt in. Use MEDIA_DRIVER=local to keep imported media
# in .data/media, or set this to true to import into R2 deliberately.
# IMPORT_ALLOW_R2_IN_DEV=true
# Upload size cap in MB (Vercel's request body limit is ~4.5 MB).
MAX_UPLOAD_MB=4

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Bearer secret for /api/cron/keepalive (Vercel Cron sends it automatically).
CRON_SECRET=
# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX), from GA → Admin →
# Data streams → your web stream. Set it in Vercel (Production) only; leave it
# empty locally. It only ever runs in a production build served from the https
# NEXT_PUBLIC_SITE_URL origin. See docs/ANALYTICS.md.
NEXT_PUBLIC_GA_ID=
